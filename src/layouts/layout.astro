---
// Layout de base : il enveloppe toutes les pages du site.
import '../styles/global.css';
import Navbar from '../components/navbar.astro';
import Footer from '../components/footer.astro';
import Toast from '../components/ui/toast.astro';
import { lien } from '../lib/adresses.ts';

interface Props {
	titre?: string;
	description?: string;
}

const {
	titre = 'Repolink',
	description = 'Trouve des repos GitHub à ta portée et rencontre des créateurs.',
} = Astro.props;

// « Blog · Repolink » sur les pages, « Repolink » seul sur l'accueil
// Adresse officielle de la page (sans ?filtres ni #ancre), pour que les moteurs de recherche ne la comptent qu'une fois
const adresseCanonique = new URL(Astro.url.pathname, Astro.site).href;

const imagePartage = new URL(lien('/image-partage.png'), Astro.site).href;

const titreComplet = titre === 'Repolink' ? titre : `${titre} · Repolink`;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={lien('/favicon.svg')} />
		<link rel="icon" href={lien('/favicon.ico')} sizes="48x48" />
		<link rel="apple-touch-icon" href={lien('/apple-touch-icon.png')} />
		<link rel="manifest" href={lien('/site.webmanifest')} />
		<meta name="theme-color" content="#0d1117" />
		<link rel="canonical" href={adresseCanonique} />
		<!-- Aperçu du lien quand la page est partagée (réseaux sociaux, messageries) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Repolink" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:title" content={titreComplet} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={adresseCanonique} />
		<meta property="og:image" content={imagePartage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Repolink : trouve des repos GitHub à ta portée et rencontre des créateurs." />
		<meta name="twitter:card" content="summary_large_image" />
		<title>{titreComplet}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-fond-page text-texte-principal antialiased">
		<!-- Lien d'évitement : visible seulement au clavier, il saute la navigation -->
		<a
			href="#principal"
			class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-fond-carte focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:ring-2 focus:ring-accent-lien focus:outline-none"
			>Aller au contenu</a
		>
		<Navbar />
		<slot />
		<!-- mt-auto : le footer reste en bas de page, même quand le contenu est court -->
		<Footer />

			<!-- Notifications : src/scripts/toasts.ts y ajoute des toasts (sous la navbar, à droite, comme dans la maquette) -->
			<div
				id="zone-toasts"
				class="pointer-events-none fixed top-[100px] right-4 sm:right-10 z-50 flex flex-col items-end gap-3"
			>
			</div>
			<template id="modele-toast-succes"><Toast>__message__</Toast></template>
			<template id="modele-toast-erreur"><Toast variante="erreur">__message__</Toast></template>

			<!-- Boutons Star, Suivre et état de connexion de la navbar : actifs sur toutes les pages -->
			<script>
				import '../scripts/favoris.ts';
				import '../scripts/session.ts';
			</script>
	</body>
</html>
