---
// Layout de base : il enveloppe toutes les pages du site.
// La navbar et le footer y seront ajoutés aux étapes 2.3 et 2.4.
import '../styles/global.css';

interface Props {
	titre?: string;
	description?: string;
}

const {
	titre = 'Repolink',
	description = 'Trouve des repos GitHub à ta portée et rencontre des créateurs.',
} = Astro.props;

// « Blog · Repolink » sur les pages, « Repolink » seul sur l'accueil
const titreComplet = titre === 'Repolink' ? titre : `${titre} · Repolink`;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{titreComplet}</title>
	</head>
	<body class="min-h-screen bg-fond-page text-texte-principal antialiased">
		<slot />
	</body>
</html>
