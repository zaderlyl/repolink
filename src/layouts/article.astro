---
// Gabarit des pages de contenu (maquettes Figma : Guide, Documentation, Mentions légales, etc.).
// Titre, introduction et sections viennent des props ; `sommaire` ajoute la colonne de liens à gauche.
// Le contenu supplémentaire (ex. réglages des cookies) se met dans le slot, après les sections.
import Layout from './layout.astro';
import { lien } from '../lib/adresses.ts';
import type { Bloc } from '../data/blog';

interface Section {
	id: string;
	titre: string;
	texte?: string;
	// Paragraphes, listes et commandes (articles de blog), affichés après `texte`
	blocs?: Bloc[];
}

interface Props {
	titre: string;
	description: string;
	intro: string;
	sections: Section[];
	// Titre de la colonne de gauche ; les liens sont tirés des sections
	sommaire?: string;
	// Libellés courts du sommaire, dans l'ordre des sections (par défaut : le titre de la section)
	libellesSommaire?: string[];
}

const { titre, description, intro, sections, sommaire, libellesSommaire } = Astro.props;

// {base} dans un texte devient le dossier du site (« /repolink » sur GitHub Pages)
const html = (texte: string) => texte.replaceAll('{base}', lien(''));
const classesTexte = 'text-[15px] leading-6 text-texte-secondaire [&_a]:text-accent-lien [&_a:hover]:underline [&_code]:rounded [&_code]:bg-fond-champ [&_code]:px-1 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-[13px] [&_strong]:text-texte-principal';
---

<Layout titre={titre} description={description}>
	<slot name="head" slot="head" />
	<main id="principal" tabindex="-1" class:list={['mx-auto flex w-full max-w-360 gap-10 px-4 sm:px-10 pt-6', !sommaire && 'justify-center']}>
		{
			sommaire && (
				<nav
					aria-label={sommaire}
					class="hidden h-fit w-[300px] shrink-0 rounded-xl border border-bordure-defaut bg-fond-page p-5 md:block"
				>
					<p class="text-sm font-semibold">{sommaire}</p>
					<ul class="mt-5 flex flex-col gap-6 text-sm text-texte-secondaire">
						{sections.map((section, i) => (
							<li>
								<a href={`#${section.id}`} class="transition-colors hover:text-accent-lien">
									{libellesSommaire?.[i] ?? section.titre}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}

		<div class:list={['w-full', sommaire ? 'max-w-[820px]' : 'max-w-[800px]']}>
			<h1 class="font-titre text-[40px] leading-tight font-bold">{titre}</h1>
			<!-- Slot « entete » : auteur et image des articles de blog, entre le titre et l'intro -->
			<slot name="entete" />
			<p class:list={['text-[17px] leading-6 text-texte-secondaire', Astro.slots.has('entete') ? 'mt-6' : 'mt-4']}>{intro}</p>

			<div class="mt-6 flex flex-col gap-5">
				{
					sections.map((section) => (
						<section id={section.id} class="scroll-mt-6">
							<h2 class="text-[22px] leading-7 font-semibold">{section.titre}</h2>
							{section.texte && <p class={`mt-3 ${classesTexte}`}>{section.texte}</p>}
							{section.blocs?.map((bloc) => {
								if (bloc.type === 'p') return <p class={`mt-3 ${classesTexte}`} set:html={html(bloc.texte)} />;
								if (bloc.type === 'liste') {
									const Liste = bloc.ordonnee ? 'ol' : 'ul';
									return (
										<Liste class:list={['mt-3 flex flex-col gap-1.5 pl-6', bloc.ordonnee ? 'list-decimal' : 'list-disc', classesTexte]}>
											{bloc.items.map((item) => <li set:html={html(item)} />)}
										</Liste>
									);
								}
								return (
									<pre class="mt-3 overflow-x-auto rounded-lg border border-bordure-defaut bg-fond-panneau p-4 font-mono text-[13px] leading-5 text-texte-principal"><code>{bloc.code}</code></pre>
								);
							})}
						</section>
					))
				}
			</div>

			<slot />
		</div>
	</main>
</Layout>
