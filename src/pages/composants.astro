---
// Page de démonstration : elle affiche tous les composants de l'interface,
// comme la section « Composants » de la maquette Figma.
// Chaque sous-étape de l'étape 3 y ajoute une section.
import Layout from '../layouts/layout.astro';
import Bouton from '../components/ui/bouton.astro';
import BoutonIcone from '../components/ui/bouton-icone.astro';
import BoutonStar from '../components/ui/bouton-star.astro';
import ChampRecherche from '../components/ui/champ-recherche.astro';
import ChampTexte from '../components/ui/champ-texte.astro';
import ZoneTexte from '../components/ui/zone-texte.astro';
import Selecteur from '../components/ui/selecteur.astro';
import CaseACocher from '../components/ui/case-a-cocher.astro';
import Toggle from '../components/ui/toggle.astro';
import Chip from '../components/ui/chip.astro';
import Pill from '../components/ui/pill.astro';
import Avatar from '../components/ui/avatar.astro';
import Onglets from '../components/ui/onglets.astro';
import Onglet from '../components/ui/onglet.astro';
import Pagination from '../components/ui/pagination.astro';

// Les liens de démo restent sur cette page
const adressePage = (n: number) => `/composants?page=${n}`;

const variantes = ['primaire', 'secondaire', 'danger'] as const;
---

<Layout titre="Composants" description="Démonstration des composants de l'interface Repolink.">
	<main class="mx-auto w-full max-w-360 px-10 pt-10">
		<h1 class="font-titre text-4xl font-bold">Composants</h1>
		<p class="mt-2 text-texte-secondaire">
			Tous les composants de l'interface, avec leurs états. Cette page sert à les voir et à les
			tester ; elle suit la section « Composants » de la maquette Figma.
		</p>

		<section class="mt-12" aria-labelledby="boutons">
			<h2 id="boutons" class="font-titre text-2xl font-bold">Boutons</h2>

			<h3 class="mt-6 text-sm font-semibold text-texte-secondaire">Bouton : normal, puis désactivé</h3>
			<div class="mt-3 flex flex-col gap-3">
				{
					variantes.map((variante) => (
						<div class="flex items-center gap-4">
							<span class="w-24 text-sm text-texte-secondaire">{variante}</span>
							<Bouton variante={variante}>Bouton</Bouton>
							<Bouton variante={variante} desactive>
								Bouton
							</Bouton>
						</div>
					))
				}
				<div class="flex items-center gap-4">
					<span class="w-24 text-sm text-texte-secondaire">lien</span>
					<Bouton href="/">Retour à l'accueil</Bouton>
				</div>
			</div>

			<h3 class="mt-8 text-sm font-semibold text-texte-secondaire">Bouton icône</h3>
			<div class="mt-3 flex items-center gap-3">
				<BoutonIcone label="Étoile">☆</BoutonIcone>
				<BoutonIcone label="Favori" actif>★</BoutonIcone>
				<BoutonIcone label="Ajouter">+</BoutonIcone>
				<BoutonIcone label="Précédent">‹</BoutonIcone>
				<BoutonIcone label="Suivant">›</BoutonIcone>
			</div>

			<h3 class="mt-8 text-sm font-semibold text-texte-secondaire">Bouton Star</h3>
			<div class="mt-3 flex items-center gap-3">
				<BoutonStar />
				<BoutonStar actif />
			</div>
		</section>

		<section class="mt-12" aria-labelledby="champs">
			<h2 id="champs" class="font-titre text-2xl font-bold">Champs et sélection</h2>

			<h3 class="mt-6 text-sm font-semibold text-texte-secondaire">Champ de recherche</h3>
			<ChampRecherche class="mt-3" name="recherche-demo" />

			<h3 class="mt-8 text-sm font-semibold text-texte-secondaire">
				Champ de texte : normal, avec valeur, erreur (le focus se voit en cliquant dedans)
			</h3>
			<div class="mt-3 flex flex-wrap items-start gap-6">
				<ChampTexte id="demo-nom" label="Nom" name="nom" placeholder="Saisir…" class="w-80" />
				<ChampTexte id="demo-pseudo" label="Pseudo GitHub" name="pseudo" value="@camille-d" class="w-80" />
				<ChampTexte
					id="demo-email"
					label="E-mail"
					name="email"
					type="email"
					placeholder="toi@exemple.fr"
					erreur="Champ requis"
					class="w-80"
				/>
			</div>

			<h3 class="mt-8 text-sm font-semibold text-texte-secondaire">Zone de texte et sélecteur</h3>
			<div class="mt-3 flex flex-wrap items-start gap-6">
				<ZoneTexte id="demo-message" label="Message" name="message" placeholder="Écris ton message…" class="w-80" />
				<Selecteur
					id="demo-niveau"
					label="Niveau"
					name="niveau"
					options={['Débutant', 'Intermédiaire', 'Avancé']}
					valeur="Débutant"
					class="w-80"
				/>
			</div>

			<h3 class="mt-8 text-sm font-semibold text-texte-secondaire">Case à cocher et toggle</h3>
			<div class="mt-3 flex flex-wrap items-center gap-8">
				<CaseACocher label="Non cochée" name="case-1" />
				<CaseACocher label="Cochée" name="case-2" checked />
				<Toggle label="Désactivé" name="toggle-1" />
				<Toggle label="Activé" name="toggle-2" checked />
			</div>
		</section>

		<section class="mt-12" aria-labelledby="tags">
			<h2 id="tags" class="font-titre text-2xl font-bold">Tags</h2>

			<h3 class="mt-6 text-sm font-semibold text-texte-secondaire">
				Chip : actif, puis normal avec la pastille d'un langage (le survol se voit à la souris)
			</h3>
			<div class="mt-3 flex flex-wrap items-center gap-3">
				<Chip actif>TOUT</Chip>
				<Chip couleur="#f1e05a">JavaScript</Chip>
				<Chip couleur="#3572a5">Python</Chip>
				<Chip couleur="#563d7c">CSS</Chip>
				<Chip href="/">Lien</Chip>
			</div>

			<h3 class="mt-8 text-sm font-semibold text-texte-secondaire">Pill</h3>
			<div class="mt-3 flex flex-wrap items-center gap-3">
				<Pill variante="topic">topic</Pill>
				<Pill variante="good-first-issue">good first issue</Pill>
				<Pill variante="succes">3 good first issues</Pill>
				<Pill variante="public">Public</Pill>
			</div>

			<h3 class="mt-8 text-sm font-semibold text-texte-secondaire">Avatar : S, M, L</h3>
			<div class="mt-3 flex items-center gap-4">
				<Avatar taille="s" />
				<Avatar taille="m" />
				<Avatar taille="l" />
			</div>
		</section>

		<section class="mt-12" aria-labelledby="navigation">
			<h2 id="navigation" class="font-titre text-2xl font-bold">Navigation</h2>

			<h3 class="mt-6 text-sm font-semibold text-texte-secondaire">Onglets (le survol se voit à la souris)</h3>
			<Onglets label="Sections du repo (démo)" class="mt-3 w-fit">
				<Onglet href="/composants" actif>Aperçu</Onglet>
				<Onglet href="/composants#issues">Issues</Onglet>
				<Onglet href="/composants#contributeurs">Contributeurs</Onglet>
				<Onglet href="/composants#similaires">Similaires</Onglet>
			</Onglets>

			<h3 class="mt-8 text-sm font-semibold text-texte-secondaire">
				Pagination : page 1, 2 et 3 sur 3, puis page 5 sur 12
			</h3>
			<div class="mt-3 flex flex-col gap-4">
				<Pagination courante={1} total={3} href={adressePage} label="Pagination (démo 1)" />
				<Pagination courante={2} total={3} href={adressePage} label="Pagination (démo 2)" />
				<Pagination courante={3} total={3} href={adressePage} label="Pagination (démo 3)" />
				<Pagination courante={5} total={12} href={adressePage} label="Pagination (démo 4)" />
			</div>
		</section>
	</main>
</Layout>
