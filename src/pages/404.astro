---
// Page 404 (maquette Figma : « Site - 404 »). Astro la sert pour toute adresse inconnue.
import Layout from '../layouts/layout.astro';
import Bouton from '../components/ui/bouton.astro';
---

<Layout titre="Page introuvable" description="Cette page n'existe pas ou a été déplacée.">
	<main class="flex flex-1 flex-col items-center px-10 pt-24 pb-16 text-center">
		<p aria-hidden="true" class="font-titre text-[140px] leading-none font-bold text-accent-lien">404</p>
		<h1 class="mt-8 text-[26px] leading-8 font-semibold">Page introuvable</h1>
		<p class="mt-3.5 text-[15px] text-texte-secondaire">
			Ce repo a peut-être été supprimé, renommé, ou n’a jamais existé.
		</p>
		<div class="mt-3.5 flex gap-3">
			<Bouton href="/">Retour à l’accueil</Bouton>
			<Bouton href="/recherche" variante="secondaire">Rechercher un repo</Bouton>
		</div>
	</main>
</Layout>
