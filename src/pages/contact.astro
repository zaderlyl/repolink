---
// Page « Contact » (maquette Figma : « Site - Contact »).
// Le formulaire est vérifié par src/scripts/formulaire.ts (champs obligatoires, e-mail valide, message assez long) :
// les erreurs s'affichent sous les champs. Rien n'est envoyé : une fois valide, on va sur la page « Message envoyé ».
import Layout from '../layouts/layout.astro';
import Bouton from '../components/ui/bouton.astro';
import ChampTexte from '../components/ui/champ-texte.astro';
import Selecteur from '../components/ui/selecteur.astro';
import ZoneTexte from '../components/ui/zone-texte.astro';

const sujets = ['Question générale', 'Signaler un bug', 'Proposer un projet', 'Autre'];
---

<Layout titre="Contact" description="Une idée, un bug, un projet à mettre en avant ? Écris-nous.">
	<main class="mx-auto w-full max-w-360 px-10 pt-6">
		<h1 class="font-titre text-[40px] leading-tight font-bold">Contact</h1>
		<p class="mt-2 max-w-[700px] text-base text-texte-secondaire">
			Une idée, un bug, un projet à mettre en avant ? Écris-nous, on répond sous 48 h.
		</p>

		<form
			id="formulaire-contact"
			novalidate
			class="mt-8 flex max-w-[640px] flex-col gap-4 rounded-xl border border-bordure-defaut bg-fond-page p-[23px]"
		>
			<ChampTexte id="contact-nom" name="nom" label="Nom" placeholder="Ton nom" autocomplete="name" required class="w-80" />
			<ChampTexte
				id="contact-email"
				name="email"
				type="email"
				label="E-mail"
				placeholder="toi@exemple.fr"
				autocomplete="email"
				required
				class="w-80"
			/>
			<Selecteur id="contact-sujet" name="sujet" label="Sujet" options={sujets} class="w-80" />
			<ZoneTexte
				id="contact-message"
				name="message"
				label="Message"
				placeholder="Écris ton message…"
				required
				minlength={10}
				class="w-80"
			/>
			<div class="pt-1.5">
				<Bouton type="submit">Envoyer</Bouton>
			</div>
		</form>
	</main>
</Layout>

<script>
	import { validerFormulaire } from '../scripts/formulaire.ts';

	// Les champs sont vérifiés avant d'arriver ici. Pas d'envoi réel ni de données dans l'adresse :
	// on affiche simplement la page de confirmation.
	const formulaire = document.getElementById('formulaire-contact') as HTMLFormElement | null;
	if (formulaire) validerFormulaire(formulaire, () => window.location.assign('/message-envoye'));
</script>
