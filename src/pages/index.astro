---
// Page d'accueil (maquette Figma : « Site - Accueil »), allégée : l'accroche, la recherche, les repos et les issues pour débutants.
// Le repo d'illustration du hero, les langages, les profils et la colonne « Légal » (déjà dans le footer) en ont été retirés.
// « Tes favoris » apparaît seulement si on a étoilé des repos (src/scripts/accueil.ts).
// Les données viennent de src/data/accueil.ts (factices pour l'instant, API GitHub à l'étape 5).
import Layout from '../layouts/layout.astro';
import Bouton from '../components/ui/bouton.astro';
import CarteRepo from '../components/ui/carte-repo.astro';
import LigneIssue from '../components/ui/ligne-issue.astro';
import EntetePanneau from '../components/ui/entete-panneau.astro';
import { repos, issues, hrefRepo } from '../data/accueil';
import { lien } from '../lib/adresses.ts';

// Liens du bloc « plan du site » en bas de page, en colonnes (les liens légaux sont dans le footer)
const colonnes = [
	{
		titre: 'Produit',
		liens: [
			{ texte: 'Explorer', href: lien('/explorer') },
			{ texte: 'Recherche', href: lien('/recherche') },
			{ texte: 'Good first issues', href: lien('/good-first-issues') },
		],
	},
	{
		titre: 'Ressources',
		liens: [
			{ texte: 'Guide du contributeur', href: lien('/guide') },
			{ texte: 'Documentation', href: lien('/documentation') },
			{ texte: 'Blog', href: lien('/blog') },
		],
	},
	{
		titre: 'Communauté',
		liens: [
			{ texte: 'GitHub', href: 'https://github.com/zaderlyl/repolink' },
			{ texte: 'Contact', href: lien('/contact') },
		],
	},
];
---

<Layout>
	<main id="principal" tabindex="-1">
		<!-- Hero : accroche et recherche -->
		<section class="mt-4 bg-linear-to-r from-fond-page via-[#1f1147] to-[#0e4f62]">
			<div class="mx-auto flex w-full max-w-360 items-center justify-between gap-12 px-4 sm:px-10 py-14">
				<div class="max-w-[760px]">
					<h1 class="font-titre text-5xl leading-[1.15] font-bold">Trouve le repo qui te fait progresser</h1>
					<p class="mt-4 max-w-[700px] text-lg text-texte-secondaire">
						Cherche par langage, topic ou créateur, sans la syntaxe compliquée de GitHub.
					</p>
					<form
						action={lien('/recherche')}
						method="get"
						role="search"
						class="mt-8 flex h-13 w-full max-w-[640px] items-center rounded-md border border-bordure-defaut bg-fond-page pr-2 pl-5 focus-within:border-accent-lien focus-within:ring-1 focus-within:ring-accent-lien"
					>
						<label for="recherche-accueil" class="sr-only">Rechercher un repo, un topic ou un créateur</label>
						<input
							id="recherche-accueil"
							name="q"
							type="search"
							placeholder="Rechercher un repo, un topic, un créateur…"
							class="h-full min-w-0 flex-1 bg-transparent text-[15px] text-texte-principal placeholder:text-texte-secondaire focus:outline-none"
						/>
						<Bouton type="submit" class="shrink-0">Rechercher</Bouton>
					</form>
				</div>
			</div>
		</section>

		<div class="mx-auto w-full max-w-360 px-4 sm:px-10">
			<!-- Tes favoris : rempli et montré par le script quand des repos sont étoilés -->
			<section id="favoris-accueil" hidden class="mt-8" aria-labelledby="titre-favoris-accueil">
				<div class="flex items-baseline justify-between">
					<h2 id="titre-favoris-accueil" class="text-xl font-semibold">Tes favoris</h2>
					<a href={lien('/favoris')} class="text-sm font-medium text-accent-lien hover:underline">Voir tout</a>
				</div>
				<ul id="liste-favoris-accueil" class="mt-4 grid gap-6 md:grid-cols-2"></ul>
			</section>

			<!-- Repos à la une -->
			<section class="mt-8" aria-labelledby="repos-a-la-une">
				<div class="flex items-baseline justify-between">
					<h2 id="repos-a-la-une" class="text-xl font-semibold">Repos à la une</h2>
					<a href={lien('/recherche')} class="text-sm font-medium text-accent-lien hover:underline">Voir tout</a>
				</div>
				<div class="mt-4 grid gap-6 md:grid-cols-2">
					{
						repos.map((repo) => (
							<CarteRepo
								nom={repo.nom}
								href={hrefRepo(repo.nom)}
								description={repo.description}
								miseAJour={repo.miseAJour}
								langage={repo.langage}
								couleurLangage={repo.couleurLangage}
								etoiles={repo.etoiles}
								topics={repo.topics}
								goodFirstIssues={repo.goodFirstIssues}
							/>
						))
					}
				</div>
			</section>

			<!-- Good first issues -->
			<section aria-label="Good first issues" class="mt-8 overflow-hidden rounded-xl border border-bordure-defaut">
				<EntetePanneau titre="Good first issues" lienTexte="Voir tout" lienHref={lien('/good-first-issues')} />
				{
					issues.map((issue) => (
						<LigneIssue titre={issue.titre} href={hrefRepo(issue.repo)} repo={issue.repo} ouverte={issue.ouverte} />
					))
				}
			</section>

			<!-- Plan du site : donne accès au guide, à la documentation et au blog -->
			<nav aria-label="Plan du site" class="mt-12 grid gap-8 border-t border-bordure-defaut pt-10 sm:grid-cols-2 lg:grid-cols-[1fr_repeat(3,auto)] lg:gap-16">
				<p class="font-semibold">Repolink</p>
				{
					colonnes.map((colonne) => (
						<div>
							<h2 class="text-sm font-semibold">{colonne.titre}</h2>
							<ul class="mt-3 flex flex-col gap-2 text-[13px] text-texte-secondaire">
								{colonne.liens.map((lien) => (
									<li>
										<a href={lien.href} class="transition-colors hover:text-accent-lien">
											{lien.texte}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>
		</div>
	</main>

	<!-- Modèle rempli par le script : __cle__ est remplacé par la valeur -->
	<template id="modele-repo">
		<CarteRepo
			nom="__nom__"
			href="__href__"
			description="__description__"
			miseAJour="__miseajour__"
			langage="__langage__"
			couleurLangage="__couleur__"
			etoiles="__etoiles__"
			topics={['__topic__']}
		/>
	</template>
</Layout>

<script>
	import '../scripts/accueil.ts';
</script>
