---
// Page « Recherche » (maquettes Figma : « Site - Liste de résultats » et « Site - Chargement »).
// La page est statique : les filtres sont lus dans l'adresse (?q=…&langage=…&topic=…&taille=…&page=…)
// et les résultats viennent de l'API de GitHub dans le navigateur (src/scripts/recherche.ts).
// Les <template> sont les modèles que le script remplit : ils utilisent les vrais composants.
import Layout from '../layouts/layout.astro';
import Chip from '../components/ui/chip.astro';
import ChampRecherche from '../components/ui/champ-recherche.astro';
import CarteRepo from '../components/ui/carte-repo.astro';
import EtatVide from '../components/ui/etat-vide.astro';
import Bouton from '../components/ui/bouton.astro';
import AideMots from '../components/ui/aide-mots.astro';
import { couleurLangage } from '../lib/conversion.ts';
import { hrefRecherche, TAILLES } from '../lib/recherche.ts';
import { lien } from '../lib/adresses.ts';

const langagesRapides = ['JavaScript', 'Python'];
---

<Layout titre="Recherche" description="Cherche des repos GitHub par mot-clé, langage ou topic, sans la syntaxe compliquée de GitHub.">
	<main id="principal" tabindex="-1" class="mx-auto w-full max-w-360 px-4 sm:px-10 pt-6">
		<div class="flex items-baseline gap-3">
			<h1 class="font-titre text-[40px] leading-tight font-bold">Recherche</h1>
			<p id="statut" role="status" class="text-[13px] text-texte-secondaire">Chargement des repos…</p>
		</div>

		<!-- Version de départ des pastilles : le script les remplace selon l'adresse -->
		<nav id="filtres" aria-label="Filtres par langage" class="mt-4 flex flex-wrap gap-3">
			<Chip href={lien('/recherche')} actif>TOUT</Chip>
			{langagesRapides.map((langage) => (
				<Chip href={hrefRecherche({ langages: [langage] })} couleur={couleurLangage(langage)}>{langage}</Chip>
			))}
		</nav>

		<!-- Taille du projet : « Petits projets » donne leur chance aux créateurs encore peu connus. Le script remplace les pastilles selon l'adresse. -->
		<div class="mt-3 flex flex-wrap items-center gap-3">
			<span class="text-[13px] text-texte-secondaire">Taille</span>
			<nav id="filtres-taille" aria-label="Filtrer par taille de projet" class="flex flex-wrap gap-3">
				{TAILLES.map(({ id, texte }) => (
					<Chip href={hrefRecherche({ taille: id })} actif={id === 'tous'}>{texte}</Chip>
				))}
			</nav>
		</div>

		<p id="aide-taille" hidden class="mt-2 text-[13px] text-texte-secondaire"></p>

		<!-- Tous les langages et topics : le script remplit les pastilles. Plusieurs langages = l'un OU l'autre ; plusieurs topics = tous à la fois. -->
		<details id="plus-filtres" class="mt-4 rounded-xl border border-bordure-defaut bg-fond-panneau p-4">
			<summary class="cursor-pointer text-sm font-medium"><span id="titre-plus-filtres">Plus de filtres</span></summary>
			<p class="mt-3 text-[13px] text-texte-secondaire">
				Plusieurs langages : le repo est écrit dans l'un d'eux. Plusieurs topics : le repo doit les avoir tous. 5 choix au maximum pour chacun.
			</p>
			<h2 class="mt-4 text-sm font-semibold">Langages</h2>
			<div id="choix-langages" class="mt-2 flex flex-wrap gap-2"></div>
			<h2 class="mt-6 text-sm font-semibold">Topics et frameworks</h2>
			<div id="choix-topics" class="mt-2 flex flex-col gap-4"></div>
		</details>

		<form id="formulaire-recherche" action={lien('/recherche')} method="get" role="search" class="mt-7">
			<input type="hidden" name="langage" disabled />
			<input type="hidden" name="topic" disabled />
			<input type="hidden" name="taille" disabled />
			<ChampRecherche name="q" label="Rechercher un repo, un topic ou un créateur" maxlength={100} />
		</form>

		<AideMots class="mt-4" />

		<div class="mt-6">
			<h2 class="sr-only">Résultats</h2>
			<ul id="liste" class="flex flex-col gap-4" hidden></ul>

			<!-- Chargement : trois cartes grisées, comme dans la maquette -->
			<div id="chargement" aria-hidden="true" class="flex animate-pulse flex-col gap-4">
				{[0, 1, 2].map(() => (
					<div class="flex min-h-[200px] flex-col rounded-xl border border-bordure-defaut bg-fond-page p-4">
						<div class="flex items-center justify-between">
							<div class="h-5 w-48 rounded bg-fond-champ"></div>
							<div class="h-7 w-24 rounded-md bg-fond-champ"></div>
						</div>
						<div class="mt-5 h-3 w-2/3 rounded bg-fond-champ"></div>
						<div class="mt-3 h-3 w-1/2 rounded bg-fond-champ"></div>
						<div class="mt-auto flex gap-3 pt-6">
							<div class="h-4 w-24 rounded bg-fond-champ"></div>
							<div class="h-4 w-16 rounded bg-fond-champ"></div>
							<div class="h-5 w-12 rounded-full bg-fond-champ"></div>
							<div class="h-5 w-12 rounded-full bg-fond-champ"></div>
						</div>
					</div>
				))}
			</div>

			<div id="vide" hidden>
				<EtatVide symbole="⌕" titre="Aucun repo trouvé" texte="Essaie un autre mot-clé ou retire un filtre.">
					<Bouton id="voir-tous" href={lien('/recherche')} variante="secondaire" hidden>Voir tous les projets</Bouton>
					<Bouton href={lien('/recherche')} variante="secondaire">Effacer les filtres</Bouton>
				</EtatVide>
			</div>

			<div id="erreur" hidden>
				<EtatVide symbole="!" titre="Impossible de charger les repos" texte="">
					<Bouton id="reessayer" variante="secondaire">Réessayer</Bouton>
				</EtatVide>
			</div>

			<noscript>
				<p class="rounded-xl border border-bordure-defaut bg-fond-panneau p-6 text-center text-sm text-texte-secondaire">
					Active JavaScript pour voir les résultats de la recherche.
				</p>
			</noscript>
		</div>

		<div id="pagination" class="mt-[30px] flex justify-center"></div>
	</main>

	<!-- Modèles remplis par le script : __cle__ est remplacé par la valeur -->
	<template id="modele-repo">
		<CarteRepo
			nom="__nom__"
			href="__href__"
			description="__description__"
			miseAJour="__miseajour__"
			langage="__langage__"
			couleurLangage="__couleur__"
			etoiles="__etoiles__"
			topics={['__topic__']}
			class="min-h-[200px]"
		/>
	</template>
	<template id="modele-chip"><Chip href="__href__" couleur="__couleur__">__texte__</Chip></template>
	<template id="modele-chip-actif"><Chip href="__href__" actif>__texte__</Chip></template>
</Layout>

<script>
	import '../scripts/recherche.ts';
</script>
