---
// Case à cocher avec son libellé (maquette Figma : « Checkbox »).
// La vraie case (<input>) est cachée mais reste utilisable au clavier ;
// la case dessinée à côté change d'aspect grâce à `peer-checked`.
import type { HTMLAttributes } from 'astro/types';

type Props = {
	label: string;
} & Omit<HTMLAttributes<'input'>, 'type'>;

const { label, class: classe, ...reste } = Astro.props;
---

<label class:list={['inline-flex cursor-pointer items-center gap-2 text-sm', classe]}>
	<input type="checkbox" class="peer sr-only" {...reste} />
	<span
		aria-hidden="true"
		class="grid size-[18px] place-items-center rounded border border-bordure-defaut bg-fond-page text-xs font-semibold text-blanc transition-colors peer-checked:border-bouton-primaire-bordure peer-checked:bg-bouton-primaire peer-focus-visible:ring-2 peer-focus-visible:ring-accent-lien peer-[:not(:checked)]:text-transparent"
		>✓</span
	>
	{label}
</label>
