---
// Ligne d'une page de paramètres (maquette Figma : « Ligne paramètre »).
// Deux types :
//   type="lien"   : toute la ligne est un lien (avec un chevron ›) ; il faut `href`. `courant` : c'est la page où l'on est (contour bleu).
//   type="toggle" : un interrupteur à droite ; il faut `id` et `name`, et `actif` pour le mettre en marche. `desactive` : grisé.
import type { HTMLAttributes } from 'astro/types';
import Toggle from './toggle.astro';
import { CONTOUR, CONTOUR_COURANT } from '../../lib/menu.ts';

type Props =
	| ({ type?: 'lien'; label: string; href: string; courant?: boolean } & HTMLAttributes<'a'>)
	| ({ type: 'toggle'; label: string; id: string; name: string; actif?: boolean; desactive?: boolean } & HTMLAttributes<'div'>);

const props = Astro.props;
const base =
	'flex h-14 items-center justify-between gap-4 rounded-lg bg-fond-panneau px-4 text-sm font-medium transition-colors';
// Les attributs data-* et aria-* passés à la ligne sont posés sur son élément (ex. data-section pour le script de la page)
const attributs = Object.fromEntries(Object.entries(props).filter(([nom]) => nom.startsWith('data-') || nom.startsWith('aria-')));
---

{
	props.type === 'toggle' ? (
		<div class:list={[base, CONTOUR, props.desactive && 'opacity-60', props.class]} {...attributs}>
			<label for={props.id} class:list={['flex-1', props.desactive ? 'cursor-not-allowed' : 'cursor-pointer']}>
				{props.label}
			</label>
			<Toggle id={props.id} name={props.name} checked={props.actif} disabled={props.desactive} />
		</div>
	) : (
		<a
			href={props.href}
			aria-current={props.courant ? 'page' : undefined}
			class:list={[base, props.courant ? CONTOUR_COURANT : CONTOUR, 'hover:border-accent-lien hover:bg-fond-carte', props.class]}
			{...attributs}
		>
			{props.label}
			<span aria-hidden="true" class="text-lg text-texte-secondaire">›</span>
		</a>
	)
}
