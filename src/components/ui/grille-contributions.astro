---
// Grille d'activité façon GitHub (maquette Figma : « Grille contributions »).
// `semaines` : une liste de semaines ; chaque semaine est une liste de niveaux de 0 (rien) à 4 (beaucoup),
// un par jour. La grille se lit de gauche à droite, semaine après semaine.
// `taille` : « petite » (cartes de profil) ou « grande » (page du profil). Les classes sont dans src/lib/grille.ts.
import type { HTMLAttributes } from 'astro/types';
import { NIVEAUX_GRILLE, TAILLES_GRILLE } from '../../lib/grille.ts';
import type { TailleGrille } from '../../lib/grille.ts';

type Props = {
	semaines: number[][];
	label?: string;
	taille?: TailleGrille;
} & HTMLAttributes<'div'>;

const { semaines, label = 'Activité des dernières semaines', taille = 'petite', class: classe, ...reste } = Astro.props;

const niveaux = NIVEAUX_GRILLE;
const { grille, cellule, ligne } = TAILLES_GRILLE[taille];
const lignes = Math.max(0, ...semaines.map((semaine) => semaine.length));
---

<div
	role="img"
	aria-label={label}
	class:list={[grille, classe]}
	style={`grid-template-rows: repeat(${lignes}, ${ligne})`}
	{...reste}
>
	{
		semaines.flatMap((semaine) =>
			semaine.map((niveau) => <span class:list={[cellule, niveaux[niveau] ?? niveaux[0]]} />),
		)
	}
</div>
