---
// Barre qui regroupe des onglets, avec un trait gris dessous (maquette Figma : « Onglets »).
// Exemple :
//   <Onglets label="Sections du repo">
//     <Onglet href="/repo" actif>Aperçu</Onglet>
//     <Onglet href="/repo?nom=proprietaire/repo&onglet=issues">Issues</Onglet>
//   </Onglets>
// Sur un petit écran, la barre défile à l'horizontale.
// `label` décrit la navigation pour les lecteurs d'écran.
import type { HTMLAttributes } from 'astro/types';

type Props = {
	label: string;
} & HTMLAttributes<'nav'>;

const { label, class: classe, ...reste } = Astro.props;
---

<nav aria-label={label} class:list={['flex overflow-x-auto border-b border-bordure-defaut', classe]} {...reste}>
	<slot />
</nav>
