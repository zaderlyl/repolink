---
// Carte d'un article de blog (maquette Figma : « Carte article »).
// Toute la carte est cliquable (le lien du titre s'étire dessus).
// Sans `image`, elle affiche le dégradé de la maquette à la place de l'illustration.
import type { HTMLAttributes } from 'astro/types';
import Pill from './pill.astro';

type Props = {
	titre: string;
	resume: string;
	tag: string;
	date: string;
	href: string;
	image?: string;
} & HTMLAttributes<'article'>;

const { titre, resume, tag, date, href, image, class: classe, ...reste } = Astro.props;
---

<article
	class:list={[
		'relative flex min-h-80 flex-col overflow-hidden rounded-xl border border-bordure-defaut bg-fond-page transition-colors hover:border-accent-lien hover:bg-fond-panneau',
		classe,
	]}
	{...reste}
>
	{
		image ? (
			<img src={image} alt="" class="h-40 w-full object-cover" />
		) : (
			<div aria-hidden="true" class="h-40 w-full bg-linear-to-r from-[#0e0e3a] to-[#0e4f62]" />
		)
	}
	<div class="flex flex-1 flex-col p-4">
		<Pill variante="topic" class="self-start">{tag}</Pill>
		<h3 class="mt-3.5 text-lg leading-[22px] font-semibold">
			<a href={href} class="after:absolute after:inset-0">{titre}</a>
		</h3>
		<p class="mt-2 text-[13px] leading-4 text-texte-secondaire">{resume}</p>
		<p class="mt-auto pt-3.5 text-xs leading-[15px] text-texte-secondaire">{date}</p>
	</div>
</article>
