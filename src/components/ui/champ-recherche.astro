---
// Barre de recherche large (maquette Figma : « Champ de recherche »).
// `label` est lu par les lecteurs d'écran (le champ n'a pas de libellé visible).
import type { HTMLAttributes } from 'astro/types';

type Props = {
	label?: string;
} & HTMLAttributes<'input'>;

const { label = 'Rechercher', class: classe, ...reste } = Astro.props;
---

<div class:list={['relative', classe]}>
	<svg
		aria-hidden="true"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="pointer-events-none absolute top-1/2 left-4 size-6 -translate-y-1/2 text-texte-secondaire"
	>
		<circle cx="11" cy="11" r="7"></circle>
		<path d="m20 20-3.5-3.5"></path>
	</svg>
	<input
		type="search"
		aria-label={label}
		placeholder="Recherche"
		class="h-14 w-full rounded-md border border-bordure-defaut bg-fond-page pr-4 pl-15 text-xl text-texte-principal placeholder:text-texte-secondaire hover:border-texte-secondaire focus:border-accent-lien focus:ring-1 focus:ring-accent-lien focus:outline-none aria-invalid:border-accent-danger! aria-invalid:ring-1 aria-invalid:ring-accent-danger!"
		{...reste}
	/>
</div>
