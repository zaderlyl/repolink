---
// Pagination d'une liste (maquette Figma : « Pagination »).
// `courante` : numéro de la page affichée ; `total` : nombre de pages ;
// `href` : fonction qui donne l'adresse d'une page, par exemple (n) => `/recherche?page=${n}`.
// « Préc. » est grisé sur la première page et « Suiv. » sur la dernière.
// Au-delà de 5 pages, on garde la première, la dernière et celles autour de la courante.
// La logique et les classes sont dans src/lib/pagination.ts : les pages qui se remplissent dans le navigateur les réutilisent.
import type { HTMLAttributes } from 'astro/types';
import { CLASSES_PAGINATION, elementsPagination } from '../../lib/pagination.ts';

type Props = {
	courante: number;
	total: number;
	href: (page: number) => string;
	label?: string;
} & HTMLAttributes<'nav'>;

const { courante, total, href, label = 'Pagination', class: classe, ...reste } = Astro.props;

const elements = elementsPagination(courante, total);
const { page: boutonPage, fleche: boutonFleche, survol, courante: classeCourante, desactive, ellipse } = CLASSES_PAGINATION;
---

<nav aria-label={label} class={classe} {...reste}>
	<ul class="flex items-center gap-1">
		<li>
			{
				courante > 1 ? (
					<a href={href(courante - 1)} class:list={[boutonFleche, survol]}>
						‹ Préc.
					</a>
				) : (
					<span aria-disabled="true" class:list={[boutonFleche, desactive]}>
						‹ Préc.
					</span>
				)
			}
		</li>

		{
			elements.map((element) => (
				<li>
					{element === '…' ? (
						<span class:list={[boutonPage, ellipse]}>…</span>
					) : element === courante ? (
						<span
							aria-current="page"
							aria-label={`Page ${element}`}
							class:list={[boutonPage, classeCourante]}
						>
							{element}
						</span>
					) : (
						<a href={href(element)} aria-label={`Page ${element}`} class:list={[boutonPage, survol]}>
							{element}
						</a>
					)}
				</li>
			))
		}

		<li>
			{
				courante < total ? (
					<a href={href(courante + 1)} class:list={[boutonFleche, survol]}>
						Suiv. ›
					</a>
				) : (
					<span aria-disabled="true" class:list={[boutonFleche, desactive]}>
						Suiv. ›
					</span>
				)
			}
		</li>
	</ul>
</nav>
